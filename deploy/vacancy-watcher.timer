[Unit]
Description=Запуск сбора вакансий раз в сутки

[Timer]
# каждый день в 9 утра по времени сервера
OnCalendar=*-*-* 09:00:00
# если сервер в это время лежал, запустить сразу после подъёма
Persistent=true
# разброс, чтобы не долбить сайты ровно по минутам
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
